# ============================================================
# Universal API Hub - Root .gitignore
# ============================================================

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# BUG FIX: package-lock.json was previously ignored here (and again below
# for backend/frontend specifically), which meant it was never committed to
# git. `npm ci` — used both by CI's "Install Dependencies" step and by most
# hosting platforms' default install command — REQUIRES a committed
# package-lock.json that's in sync with package.json; without one it fails
# outright ("The `npm ci` command can only install with an existing
# package-lock.json"). Lockfiles should be committed for applications (as
# opposed to publishable libraries), so this line is intentionally removed.
yarn.lock
pnpm-lock.yaml

# ── Environment ──────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS Files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.~lock.*

# ── Build outputs ────────────────────────────────────────────
dist/
build/
out/
.next/
*.tsbuildinfo

# ── Coverage ─────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Temporary ────────────────────────────────────────────────
tmp/
temp/
*.tmp

# ── Docker ───────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock

# ── Redis ────────────────────────────────────────────────────
dump.rdb

# ── PostgreSQL ──────────────────────────────────────────────
*.sqlite
*.db
*.sqlite3

# ── Backend specific ─────────────────────────────────────────
backend/logs/
backend/.env
backend/node_modules/

# ── Frontend specific ────────────────────────────────────────
frontend/dist/
frontend/.env.local
frontend/node_modules/

# ── Misc ─────────────────────────────────────────────────────
*.pem
*.key
*.crt
.cache/
.eslintcache